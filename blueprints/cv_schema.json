{
    "type": "object",
    "properties": {
        "personal_info": {
            "type": "object",
            "properties": {
                "firstname": {"type": "string"},
                "lastname": {"type": "string"},
                "email": {
                    "type": "string",
                    "format": "email"
                },
                "phone": {"type": "string"},
                "address": {"type": "string"},
                "is_willing_to_relocate": {
                    "type": "string",
                    "enum": ["yes", "no", "dont know"]
                },
                "linkedin_link": {
                    "type": "string",
                    "format": "uri"
                },
                "github_link": {
                    "type": "string",
                    "format": "uri"
                },
                "additional_websites": {
                    "type": "array",
                    "items": {"type": "string", "format": "uri"}
                }
            },
            "required": ["firstname", "lastname", "email", "phone", "address", "is_willing_to_relocate", "linkedin_link", "github_link"]
        },
        "education": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "degree": {"type": "string"},
                    "institution": {"type": "string"},
                    "location": {"type": "string"},
                    "start_date": {"type": "string", "pattern": "^(19|20)\\d{2}-(0[1-9]|1[0-2])$"},
                    "graduation_date": {"type": "string", "pattern": "^(19|20)\\d{2}-(0[1-9]|1[0-2])$"},
                    "grade": {"type": ["string", "number"]}
                },
                "required": ["degree", "institution", "location", "start_date", "graduation_date", "grade"]
            }
        },
        "experience": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "title": {"type": "string"},
                    "company": {"type": "string"},
                    "location": {"type": "string"},
                    "start_date": {"type": "string", "pattern": "^(19|20)\\d{2}-(0[1-9]|1[0-2])$"},
                    "end_date": {"type": ["string", "null"], "pattern": "^(19|20)\\d{2}-(0[1-9]|1[0-2])$"},
                    "is_ongoing": {"type": "boolean"},
                    "responsibilities": {
                        "type": "array",
                        "items": {"type": "string"}
                    },
                    "keywords": {
                        "type": "array",
                        "items": {"type": "string"}
                    }
                },
                "required": ["title", "company", "location", "start_date", "is_ongoing", "responsibilities", "keywords"]
            }
        },
        "skills": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {"type": "string"},
                    "years": {"type": "integer", "minimum": 0}
                },
                "required": ["name", "years"]
            }
        },
        "certifications": {
            "type": "array",
            "items": {"type": "string"}
        },
        "projects": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "title": {"type": "string"},
                    "description": {"type": "string"},
                    "technologies": {
                        "type": "array",
                        "items": {"type": "string"}
                    },
                    "github_link": {
                        "type": "string",
                        "format": "uri"
                    }
                },
                "required": ["title", "description", "technologies", "github_link"]
            }
        },
        "languages": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "language": {"type": "string"},
                    "level": {
                        "type": "string",
                        "enum": ["Native", "Fluent", "Intermediate", "Basic"]
                    }
                },
                "required": ["language", "level"]
            }
        },
        "achievements": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "achievement": {"type": "string"},
                    "date": {"type": "string", "pattern": "^(19|20)\\d{2}-(0[1-9]|1[0-2])$"}
                },
                "required": ["achievement", "date"]
            }
        },
        "publications": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "title": {"type": "string"},
                    "publish_date": {"type": "string", "pattern": "^(19|20)\\d{2}-(0[1-9]|1[0-2])$"},
                    "published_venue": {"type": "string"},
                    "co_authors": {"type": "string"},
                    "description": {"type": "string"},
                    "link": {
                        "type": "string",
                        "format": "uri"
                    }
                },
                "required": ["title", "publish_date", "published_venue", "co_authors", "description", "link"]
            }
        },
        "volunteer_experience": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "organization": {"type": "string"},
                    "role": {"type": "string"},
                    "location": {"type": "string"},
                    "start_date": {"type": "string", "pattern": "^(19|20)\\d{2}-(0[1-9]|1[0-2])$"},
                    "end_date": {"type": ["string", "null"], "pattern": "^(19|20)\\d{2}-(0[1-9]|1[0-2])$"},
                    "is_ongoing": {"type": "boolean"},
                    "description": {"type": "string"}
                },
                "required": ["organization", "role", "location", "start_date", "is_ongoing", "description"]
            }
        },
        "hobbies": {
            "type": "array",
            "items": {"type": "string"}
        },
        "summary": {"type": "string"}
    },
    "required": ["personal_info", "education", "experience", "skills", "certifications", "projects", "languages", "achievements", "publications", "volunteer_experience", "hobbies", "summary"]
}